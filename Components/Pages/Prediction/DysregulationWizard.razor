@* Formulario breve que arma un POST /cases/{id}/dysregulations. *@

<div class="overlay" role="dialog" aria-modal="true" aria-labelledby="dysregulation-dialog-title">
    <div class="wizard">
        <div class="wizard__head">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px">
                <div>
                    <p class="wizard__eyebrow">Nuevo registro</p>
                    <h2 id="dysregulation-dialog-title" class="wizard__title">Contar qué pasó</h2>
                </div>
                <button type="button" class="wizard__close" @onclick="OnCancel">Cerrar</button>
            </div>
        </div>

        <div class="wizard__body">
            <p class="wizard__group-label">Intensidad observada</p>
            <div class="opt-chips">
                @foreach (var option in Levels)
                {
                    <button type="button" class="opt-chip @(level == option.ApiValue ? "is-selected" : null)"
                            @onclick="() => level = option.ApiValue">@option.Name</button>
                }
            </div>

            <label class="wizard__group-label" for="dysregulation-context">Contexto en palabras</label>
            <textarea id="dysregulation-context" class="wizard__textarea" @bind="note" @bind:event="oninput"
                      placeholder="¿Qué ocurrió antes? ¿Qué estímulos o situaciones pudieron afectar?"></textarea>

            @if (error is not null)
            {
                <div class="wizard__error">@error</div>
            }
        </div>

        <div class="wizard__foot">
            <button type="button" class="btn-back" disabled="@saving" @onclick="OnCancel">Cancelar</button>
            <button type="button" class="btn-save" disabled="@saving" @onclick="SaveAsync">
                @(saving ? "Guardando…" : "Guardar registro")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string CaseId { get; set; } = default!;
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    [Inject] private BlubaApiClient Api { get; set; } = default!;

    private string level = "Nivel 2 (Desregulación moderada)";
    private string note = string.Empty;
    private string? error;
    private bool saving;
    private DysregulationCreate? pendingPayload;

    /// <summary>
    /// Escala de niveles basada en literatura reciente sobre desregulación en autismo (EOQ, EDI).
    /// Reemplaza la escala previa "Leve/Moderada/Severa (1-10)", sin respaldo bibliográfico. El
    /// formato "Nivel N (Etiqueta)" se mantiene compatible con BoardMapper.IntensityLabel, que
    /// corta en "(". Fundamento y citas completas en docs/CAMBIO_ESCALA_DESREGULACION.md.
    /// </summary>
    private static readonly (string ApiValue, string Name)[] Levels =
    [
        ("Nivel 1 (Activación leve)", "Leve"),
        ("Nivel 2 (Desregulación moderada)", "Moderada"),
        ("Nivel 3 (Desregulación alta)", "Alta"),
        ("Nivel 4 (Crisis / riesgo de seguridad)", "Crisis / riesgo de seguridad"),
    ];

    private async Task SaveAsync()
    {
        saving = true;
        error = null;

        pendingPayload ??= new DysregulationCreate(
            OccurredAt: DateTime.UtcNow,
            Type: "No informado",
            Intensity: level,
            StrategyApplied: "No informado",
            StrategyResult: "No informado",
            ReportedByType: "FAMILY",
            ClientEventId: Guid.NewGuid().ToString("n"),
            SuspectedTriggerText: string.IsNullOrWhiteSpace(note) ? null : note.Trim());

        var created = await Api.CreateDysregulationAsync(CaseId, pendingPayload);

        saving = false;

        if (created is null)
        {
            error = $"No se pudo guardar el episodio. {Api.LastError}";
            return;
        }

        await OnSaved.InvokeAsync();
    }
}
