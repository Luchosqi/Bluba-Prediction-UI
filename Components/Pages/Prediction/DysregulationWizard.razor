@* Asistente de 5 pasos que arma un POST /cases/{id}/dysregulations. *@

<div class="overlay" role="dialog" aria-modal="true" aria-labelledby="dysregulation-dialog-title">
    <div class="wizard">
        <div class="wizard__head">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px">
                <div>
                    <p class="wizard__eyebrow">Nuevo registro</p>
                    <h2 id="dysregulation-dialog-title" class="wizard__title">Registrar desregulación</h2>
                </div>
                <button type="button" class="wizard__close" @onclick="OnCancel">Cerrar</button>
            </div>

            <div class="wizard__steps">
                <p>Paso @step de 5</p>
                <p>Registro breve y guiado</p>
            </div>
            <div class="wizard__progress" aria-label="Progreso: paso @step de 5">
                @for (var i = 1; i <= 5; i++)
                {
                    <span class="@(i <= step ? "is-done" : null)"></span>
                }
            </div>
        </div>

        <div class="wizard__body wizard__body--tall">
            @switch (step)
            {
                case 1:
                    <h3 class="wizard__question">¿Qué nivel de desregulación observaste?</h3>
                    <p class="wizard__hint">
                        Escala de 4 niveles basada en intensidad, duración, tiempo de recuperación y conductas
                        de riesgo reportadas en literatura reciente (EOQ, Teixeira et al., 2024; EDI, Mazefsky
                        et al., 2018). Fundamento completo en <code>docs/CAMBIO_ESCALA_DESREGULACION.md</code>.
                    </p>
                    <div class="opt-grid-2">
                        @foreach (var option in Levels)
                        {
                            <button type="button" class="opt-intensity @(level == option.ApiValue ? "is-selected" : null)"
                                    @onclick="() => level = option.ApiValue">
                                <div class="opt-intensity__head">
                                    <span class="opt-intensity__dot" style="background:@option.Color"></span>
                                    <span class="opt-intensity__range">Nivel @option.Code</span>
                                </div>
                                <p class="opt-intensity__name">@option.Name</p>
                                <p class="opt-intensity__desc">@option.Description</p>
                            </button>
                        }
                    </div>

                    <p class="wizard__group-label">Duración aproximada del episodio</p>
                    <div class="opt-chips">
                        @foreach (var option in DurationBuckets)
                        {
                            <button type="button" class="opt-chip @(duration == option ? "is-selected" : null)"
                                    @onclick="() => duration = option">@option</button>
                        }
                    </div>

                    <p class="wizard__group-label">Tiempo hasta volver a la línea base (recuperación)</p>
                    <div class="opt-chips">
                        @foreach (var option in RecoveryBuckets)
                        {
                            <button type="button" class="opt-chip @(recovery == option ? "is-selected" : null)"
                                    @onclick="() => recovery = option">@option</button>
                        }
                    </div>

                    <p class="wizard__group-label">Conductas observadas durante el episodio</p>
                    <div class="opt-chips">
                        @foreach (var option in RiskBehaviors)
                        {
                            <button type="button" class="opt-chip @(behaviors.Contains(option) ? "is-selected" : null)"
                                    @onclick="() => ToggleBehavior(option)">@option</button>
                        }
                    </div>
                    @if (levelLockedByRisk)
                    {
                        <p class="wizard__notice">
                            Nivel ajustado a 4 (Crisis / riesgo de seguridad): la agresión física y la
                            autolesión se asocian empíricamente a episodios más severos (estudio de crisis
                            leves vs. severas en autismo, Scientific Reports, 2024 — ver referencia completa
                            en <code>docs/CAMBIO_ESCALA_DESREGULACION.md</code>). Puedes corregirlo
                            manualmente si no corresponde.
                        </p>
                    }
                    break;

                case 2:
                    <h3 class="wizard__question">¿Dónde y en qué momento ocurrió?</h3>
                    <p class="wizard__hint">Selecciona el lugar y la transición que ocurrió justo antes.</p>
                    <p class="wizard__group-label">Lugar</p>
                    <div class="opt-chips">
                        @foreach (var option in Locations)
                        {
                            <button type="button" class="opt-chip @(location == option ? "is-selected" : null)"
                                    @onclick="() => location = option">@option</button>
                        }
                    </div>
                    <p class="wizard__group-label">Transición previa</p>
                    <div class="opt-chips">
                        @foreach (var option in Transitions)
                        {
                            <button type="button" class="opt-chip @(transition == option ? "is-selected" : null)"
                                    @onclick="() => transition = option">@option</button>
                        }
                    </div>
                    break;

                case 3:
                    <h3 class="wizard__question">¿Cuál fue el desencadenante primario?</h3>
                    <p class="wizard__hint">Escoge la causa más relevante según lo que observaste.</p>
                    <div class="opt-list">
                        @foreach (var option in Triggers)
                        {
                            <button type="button" class="opt-row @(trigger == option.Label ? "is-selected" : null)"
                                    @onclick="() => trigger = option.Label">
                                <span>@option.Label</span>
                                <span class="opt-radio"></span>
                            </button>
                        }
                    </div>
                    break;

                case 4:
                    <h3 class="wizard__question">¿Qué apoyo aplicaste y cómo funcionó?</h3>
                    <p class="wizard__hint">Registra el apoyo principal y una apreciación rápida de su efecto.</p>
                    <p class="wizard__group-label">Apoyo usado</p>
                    <div class="opt-chips">
                        @foreach (var option in Supports)
                        {
                            <button type="button" class="opt-chip @(support == option ? "is-selected" : null)"
                                    @onclick="() => support = option">@option</button>
                        }
                    </div>
                    <p class="wizard__group-label">Efectividad</p>
                    <div class="opt-grid-3">
                        @foreach (var option in Effects)
                        {
                            <button type="button" class="opt-face opt-face--compact @(effect == option.ApiValue ? "is-selected" : null)"
                                    @onclick="() => effect = option.ApiValue">
                                <span class="opt-face__emoji" aria-hidden="true">@option.Emoji</span>
                                <span class="opt-face__label">@option.Label</span>
                            </button>
                        }
                    </div>
                    break;

                default:
                    <h3 class="wizard__question">¿Algo más que debamos saber?</h3>
                    <p class="wizard__hint">Este comentario es opcional y ayuda a detectar patrones con mayor precisión.</p>
                    <label class="wizard__group-label" for="dysregulation-note">
                        Comentarios generales <span class="is-optional">(opcional)</span>
                    </label>
                    <textarea id="dysregulation-note" class="wizard__textarea" @bind="note" @bind:event="oninput"
                              placeholder="Detalles adicionales sobre observaciones o pródromos previos..."></textarea>
                    <div class="wizard__notice">
                        El registro se incorporará al historial del consultante y ayudará a mejorar futuras recomendaciones.
                    </div>
                    break;
            }

            @if (error is not null)
            {
                <div class="wizard__error">@error</div>
            }
        </div>

        <div class="wizard__foot">
            <button type="button" class="btn-back" disabled="@saving"
                    @onclick="@(() => { if (step == 1) OnCancel.InvokeAsync(); else step--; })">
                @(step == 1 ? "Cancelar" : "Atrás")
            </button>

            @if (step < 5)
            {
                <button type="button" class="btn-next" @onclick="() => step++">Siguiente</button>
            }
            else
            {
                <button type="button" class="btn-save" disabled="@saving" @onclick="SaveAsync">
                    @(saving ? "Guardando…" : "Guardar registro y alimentar modelo")
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string CaseId { get; set; } = default!;
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    [Inject] private BlubaApiClient Api { get; set; } = default!;

    private int step = 1;
    private string level = "Nivel 2 (Desregulación moderada)";
    private string? duration;
    private string? recovery;
    private readonly HashSet<string> behaviors = new();
    private string? location;
    private string? transition;
    private string? trigger;
    private string? support;
    private string effect = "Regulación Parcial";
    private string note = string.Empty;
    private string? error;
    private bool saving;

    private bool levelLockedByRisk => behaviors.Contains("Agresión física") || behaviors.Contains("Autolesión");

    /// <summary>
    /// Escala ordinal 0–4 propuesta a partir de EOQ (intensidad/duración/recuperación/conductas,
    /// Teixeira et al., 2024) y EDI (reactividad como continuo, Mazefsky et al., 2018). Reemplaza la
    /// escala previa "Leve/Moderada/Severa (1-10)", que no tenía respaldo bibliográfico. El formato
    /// "Nivel N (Etiqueta)" se mantiene compatible con BoardMapper.IntensityLabel, que corta en "(".
    /// Detalle y fuentes completas en docs/CAMBIO_ESCALA_DESREGULACION.md.
    /// </summary>
    private static readonly (string ApiValue, string Code, string Name, string Color, string Description)[] Levels =
    [
        ("Nivel 1 (Activación leve)", "1", "Activación leve",
            "#38a477", "Reactividad y recuperación breves (<5 min); se autorregula con apoyo mínimo."),
        ("Nivel 2 (Desregulación moderada)", "2", "Desregulación moderada",
            "#dca82e", "Reactividad y recuperación de 5–15 min; requiere co-regulación activa del adulto."),
        ("Nivel 3 (Desregulación alta)", "3", "Desregulación alta",
            "#e2793f", "Reactividad y/o recuperación de 15–60 min; pérdida funcional significativa de la rutina."),
        ("Nivel 4 (Crisis / riesgo de seguridad)", "4", "Crisis / riesgo de seguridad",
            "#d85d5d", "Duración o recuperación >60 min, o agresión física/autolesión; requiere co-regulación intensiva."),
    ];

    private static readonly string[] DurationBuckets = ["<5 min", "5–15 min", "15–60 min", ">60 min"];
    private static readonly string[] RecoveryBuckets = ["<5 min", "5–15 min", "15–60 min", ">60 min"];
    private static readonly string[] RiskBehaviors =
        ["Llanto / vocalización", "Evitación / huida", "Agresión verbal", "Agresión física", "Autolesión"];

    private void ToggleBehavior(string option)
    {
        if (!behaviors.Remove(option)) behaviors.Add(option);
        if (levelLockedByRisk) level = "Nivel 4 (Crisis / riesgo de seguridad)";
    }

    private static readonly string[] Locations =
        ["Escuela / Aula", "Recreo", "Furgón / Trayecto", "Casa / Entrada", "Terapia"];

    private static readonly string[] Transitions =
        ["Salida del colegio", "Cambio de actividad", "Llegada a casa", "Sin cambio evidente"];

    /// <summary>Cada desencadenante define también el tipo_evento que espera la API.</summary>
    private static readonly (string Label, string EventType)[] Triggers =
    [
        ("Ruido / Sobrecarga auditiva", "Sobrecarga Sensorial"),
        ("Cambio de rutina no anticipado", "Transición de Actividad"),
        ("Frustración / Exigencia cognitiva", "Desregulación Emocional"),
        ("Sobrecarga táctil / sensorial", "Sobrecarga Sensorial"),
        ("Malestar físico / Digestivo", "Alimentación"),
    ];

    private static readonly string[] Supports =
        ["Audífonos", "Espacio seguro / Calma", "Presión profunda / Chaleco", "Apoyo visual / Pictogramas"];

    private static readonly (string ApiValue, string Emoji, string Label)[] Effects =
    [
        ("Regulación Exitosa", "😊", "Logró regularse"),
        ("Regulación Parcial", "😐", "Parcial / requirió tiempo"),
        ("Sin Regulación", "🙁", "No funcionó"),
    ];

    private async Task SaveAsync()
    {
        saving = true;
        error = null;

        var eventType = Triggers.FirstOrDefault(item => item.Label == trigger).EventType ?? "Desregulación Emocional";

        // Duración, recuperación y conductas (dimensiones EOQ) viajan como texto estructurado porque
        // la API aún no tiene columnas dedicadas para ellas; ver propuesta de esquema en el .md de cambios.
        var context = new[]
            {
                location,
                transition,
                trigger,
                duration is null ? null : $"Duración: {duration}",
                recovery is null ? null : $"Recuperación: {recovery}",
                behaviors.Count > 0 ? $"Conductas: {string.Join(", ", behaviors)}" : null,
                string.IsNullOrWhiteSpace(note) ? null : note.Trim(),
            }
            .Where(part => !string.IsNullOrWhiteSpace(part));
        var triggerText = string.Join(". ", context);

        var created = await Api.CreateDysregulationAsync(CaseId, new DysregulationCreate(
            OccurredAt: DateTime.UtcNow,
            Type: eventType,
            Intensity: level,
            StrategyApplied: support ?? "Acompañamiento sin apoyo específico",
            StrategyResult: effect,
            ReportedByType: "FAMILY",
            ClientEventId: Guid.NewGuid().ToString("n"),
            SuspectedTriggerText: string.IsNullOrWhiteSpace(triggerText) ? null : triggerText));

        saving = false;

        if (created is null)
        {
            error = $"No se pudo guardar el episodio. {Api.LastError}";
            return;
        }

        await OnSaved.InvokeAsync();
    }
}
